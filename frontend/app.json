{
  "expo": {
    "name": "frontend",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.wallettracker.d61t03",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Sblocca l'app con Face ID",
        "NSCameraUsageDescription": "Fotografa gli scontrini per registrarli",
        "NSPhotoLibraryUsageDescription": "Scegli uno scontrino dalla galleria"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.emergent.wallettracker.d61t03",
      "permissions": ["android.permission.CAMERA", "android.permission.READ_MEDIA_IMAGES"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "@react-native-vector-icons/feather",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Sblocca l'app con Face ID"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Scegli uno scontrino dalla galleria",
          "cameraPermission": "Fotografa gli scontrini per registrarli"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
